{
  "name": "node-vtex-api-workspace",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo root for @vtex/api (lib) and @vtex/api-runtime (runtime). Not published.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "clean": "yarn workspaces run clean",
    "build": "yarn workspaces run build",
    "watch": "yarn workspaces run watch",
    "gen": "yarn workspaces run gen",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "format": "yarn workspaces run format",
    "format-lint": "yarn format && yarn lint",
    "ci:build": "yarn workspaces run ci:build",
    "ci:test": "yarn workspaces run ci:test",
    "ci:prettier-check": "yarn workspaces run ci:prettier-check"
  },
  "engines": {
    "node": ">=8"
  },
  "keywords": [
    "vtex"
  ],
  "repository": {
    "type": "git",
    "url": "git@github.com:vtex/node-vtex-api.git"
  },
  "license": "MIT",
  "resolutions": {
    "@grpc/grpc-js": "^1.13.4"
  }
}
