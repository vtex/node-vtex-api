{
  "extends": "tslint-config-vtex",
  "rules": {
    "semicolon": {
      "severity": "warning",
      "options": ["never"]
    },
    "quotemark": {
      "severity": "warning",
      "options": ["single", "jsx-double"]
    },
    "trailing-comma": {
      "severity": "warning",
      "options": [
        {
          "multiline": {
            "arrays": "always",
            "functions": "never",
            "objects": "always",
            "typeLiterals": "ignore"
          },
          "esSpecCompliant": true
        }
      ]
    },
    "ordered-imports": { "severity": "warning" },
    "member-ordering": { "severity": "warning" },
    "member-access": { "severity": "warning" },
    "object-literal-sort-keys": { "severity": "warning" },
    "no-unnecessary-initializer": { "severity": "warning" },
    "variable-name": { "severity": "warning" },
    "jsdoc-format": { "severity": "warning" },
    "no-empty": { "severity": "warning" },
    "callable-types": { "severity": "warning" },
    "prefer-const": { "severity": "warning" },
    "array-type": { "severity": "warning" }
  }
}
